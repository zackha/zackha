{
  "name": "zackha",
  "version": "2.0.1",
  "description": "A phosphor-lit BBS terminal business card — responsive full-screen TUI, live GitHub signal, pixel-perfect photo on kitty/iTerm2/Ghostty/WezTerm. Run: npx zackha",
  "type": "module",
  "bin": {
    "zackha": "index.js"
  },
  "main": "index.js",
  "exports": "./index.js",
  "scripts": {
    "start": "node index.js",
    "prepublishOnly": "node --check index.js && node index.js --static > /dev/null",
    "build:avatar": "node build-avatar.js"
  },
  "keywords": [
    "cli",
    "card",
    "business-card",
    "terminal",
    "bbs",
    "bio",
    "npx",
    "github",
    "profile",
    "interactive",
    "retro",
    "amber",
    "chalk",
    "tui",
    "kitty",
    "iterm2",
    "crt",
    "phosphor"
  ],
  "author": {
    "name": "Sefa Bulak",
    "url": "https://github.com/zackha"
  },
  "license": "MIT",
  "homepage": "https://github.com/zackha/zackha#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zackha/zackha.git"
  },
  "bugs": {
    "url": "https://github.com/zackha/zackha/issues"
  },
  "files": [
    "index.js",
    "config.js",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "open": "^11.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
